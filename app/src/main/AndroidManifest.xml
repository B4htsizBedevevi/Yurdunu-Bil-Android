<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/yurdunu_bil_app_icon"
        android:roundIcon="@drawable/yurdunu_bil_app_icon"
        android:label="Yurdunu Bil"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.YurdunuBil">
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="announcements" />
        <activity android:name=".RetentionMainActivity" android:exported="false" />
        <activity android:name=".SmartStudyCenterActivity" android:exported="false" />
        <activity android:name=".SocialCenterActivity" android:exported="false" />
        <activity android:name=".AdminCenterActivity" android:exported="false" />
        <activity android:name=".ProfileOnboardingActivity" android:exported="false" />
        <activity android:name=".AdminNotificationActivity" android:exported="false" />
        <activity android:name=".AuthExperienceActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yurdunubil" android:host="auth" />
            </intent-filter>
        </activity>
        <activity android:name=".ModernLaunchActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".YurdunuBilFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver android:name=".DailyReminderReceiver" android:exported="false" />
        <receiver android:name=".NotificationBootReceiver" android:enabled="true" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
